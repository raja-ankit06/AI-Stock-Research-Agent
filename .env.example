# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# AI-Powered Multi-Agent System for Market Analysis and Research
# (Multi-Agent Stock Research Analyst)
#
# IMPORTANT:
# 1. Copy this file to .env before starting the application:
#    cp .env.example .env
# 2. Never commit actual secret keys or API credentials to version control.
# 3. All placeholder values below must be populated with your own credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="Multi-Agent Stock Research Analyst"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security & JSON Web Tokens (JWT)
# Generate a secure 64-character secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Cross-Origin Resource Sharing) - JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=stock_analyst_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. IN-MEMORY CACHE & RATE LIMITING (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM PROVIDER CONFIGURATION
# Supported providers: "openai", "anthropic", "gemini"
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai

# OpenAI Configuration (Default)
OPENAI_API_KEY=placeholder_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (Alternative)
ANTHROPIC_API_KEY=placeholder_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Alternative)
GEMINI_API_KEY=placeholder_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 5. FINANCIAL MARKET DATA & NEWS API PROVIDERS
# Obtain free/developer tier keys from provider portals
# ------------------------------------------------------------------------------
# Polygon.io (Equities, OHLCV, Quotes)
POLYGON_API_KEY=placeholder_polygon_api_key_here

# Alpha Vantage (Alternative Quote & Fundamental Data)
ALPHA_VANTAGE_API_KEY=placeholder_alpha_vantage_api_key_here

# Financial Modeling Prep (FMP) (Financial Statements & Ratios)
FMP_API_KEY=placeholder_fmp_api_key_here

# Finnhub (Financial News & Sentiment Feed)
FINNHUB_API_KEY=placeholder_finnhub_api_key_here

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & TELEMETRY
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RESEARCH_RATE_LIMIT_PER_MINUTE=5
ENABLE_TELEMETRY=false

